{
  "manifest_version": 3,
  "name": "YouTube Auto Speed",
  "version": "2.0",
  "description": "Plays music videos at 1x; cycle everything else through 1x / 1.25x / 1.5x.",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "cycle-speed": {
      "suggested_key": {
        "default": "Ctrl+Shift+S"
      },
      "description": "Cycle speed (non-music videos): 1x / 1.25x / 1.5x"
    }
  },
  "content_scripts": [
    {
      "matches": ["*://www.youtube.com/*"],
      "js": ["src/content.js"],
      "css": ["src/styles.css"],
      "run_at": "document_start"
    }
  ],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
